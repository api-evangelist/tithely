          "name": "Attach a tokenized payment method to a user",
          "request": {
            "name": "Attach a tokenized payment method to a user",
            "description": {
              "content": "V1 endpoint. Attaches a card or bank token produced by Tithely.js to a user so it can be charged repeatedly (e.g. recurring giving). Base URL is the V1 host (live https://tithe.ly/api/v1, test https://tithelydev.com/api/v1).",
              "type": "text/plain"
            },
            "url": {
