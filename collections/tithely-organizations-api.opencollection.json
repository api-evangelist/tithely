{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tithe.ly Accounts Organizations API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve one or more organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tithe.ly/api/v2/organization/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Organization ID, or comma-separated list of organization IDs."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a single organization by ID, or multiple organizations when a comma-separated list of IDs is supplied."
        },
        {
          "info": {
            "name": "Search organizations by owner",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tithe.ly/api/v2/organization-owner/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Owner (user) ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns the organizations owned by the given owner (user) ID."
        }
      ]
    }
  ],
  "bundled": true
}